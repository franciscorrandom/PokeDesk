{
  "name": "pokedesk",
  "productName": "Pok\u00e9Desk",
  "version": "1.5.2-beta.1",
  "description": "Compa\u00f1eros 3D de escritorio con calendario iCal, tareas, notas y concentraci\u00f3n",
  "author": "Francisco Opazo",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "vendor": "node scripts/prepare.cjs",
    "prestart": "npm run vendor",
    "presmoke": "npm run vendor",
    "prebuild:windows": "npm run vendor",
    "prebuild:windows:zip": "npm run vendor",
    "prebuild:preview:mac": "npm run vendor",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "build:windows": "electron-builder --win nsis zip --x64",
    "build:windows:zip": "electron-builder --win zip --x64",
    "build:preview:mac": "electron-builder --mac dir --arm64",
    "pretest": "npm run vendor"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cl.guiaestudio.pokedesk",
    "productName": "PokeDesk",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/PokeDesk.ico",
      "signExecutable": false,
      "artifactName": "PokeDesk-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "assets/PokeDesk.icns"
    }
  },
  "license": "MIT"
}
